{
  "name": "zero-knowledge-aadhar",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3010",
    "build": "next build",
    "start": "next start -p 3010",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "bash scripts/check-secrets.sh && npm run test:unit && npm run test:integration",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "migrate": "tsx --tsconfig scripts/tsconfig.json scripts/migrate.ts",
    "dev:setup": "tsx --tsconfig scripts/tsconfig.json scripts/dev-setup.ts",
    "volunteer:add": "tsx --tsconfig scripts/tsconfig.json scripts/volunteer-add.ts",
    "make-test-qr": "tsx --tsconfig scripts/tsconfig.json scripts/make-test-qr.ts",
    "reconcile-anchors": "tsx --tsconfig scripts/tsconfig.json scripts/reconcile-anchors.ts",
    "cleanup": "tsx --tsconfig scripts/tsconfig.json scripts/cleanup.ts",
    "check-secrets": "bash scripts/check-secrets.sh"
  },
  "overrides": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "dependencies": {
    "@anon-aadhaar/core": "2.4.3",
    "@anon-aadhaar/react": "2.4.3",
    "iron-session": "9.0.1",
    "next": "16.3.5",
    "pg": "^8.13.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "snarkjs": "^0.7.5",
    "viem": "^2.21.54",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/pg": "^8.11.10",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^16.4.7",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "qrcode": "^1.5.4",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "vitest": "^5.0.0"
  }
}
