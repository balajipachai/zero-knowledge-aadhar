# Copy to .env.local and fill in real values for local development.
# .env.local is gitignored -- never commit it.

# Postgres connection string. Locally, DATABASE_URL=postgresql://localhost:5432/zk_aadhaar_dev
# (passwordless local auth as the OS user). In any hosted environment, use a
# full credentialed URL but keep it OUT of this file:
#   postgresql://USER:PASSWORD@HOST:5432/DB
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB

# iron-session encryption password. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=REPLACE_WITH_A_RANDOM_32PLUS_CHAR_STRING

# "test" uses @anon-aadhaar/core's testPublicKeyHash and lets applicants
# prove with a synthetic test QR. "production" requires a real signed
# Aadhaar QR and the real UIDAI public key hash.
ANON_AADHAAR_MODE=test

# Client-side mirror of the flag above (must be NEXT_PUBLIC_-prefixed to
# reach the browser bundle; keep these two in sync).
NEXT_PUBLIC_ANON_AADHAAR_MODE=test

# Opaque bytes32 identifier for the current grant cycle, e.g.
#   node -e "console.log(require('crypto').createHash('sha256').update('2026-h1').digest('hex'))"
# then prefix with 0x. Must match the cycleId the deployed
# GrantCycleRegistry was constructed with.
CYCLE_ID=0xREPLACE_WITH_KECCAK_OR_SHA256_OF_YOUR_CYCLE_NAME

# uint256 decimal nullifier seed for this cycle. Must match the deployed
# registry's immutable nullifierSeed. Generate a fresh one per cycle, e.g.:
#   node -e "console.log(BigInt('0x' + require('crypto').randomBytes(16).toString('hex')).toString())"
NULLIFIER_SEED=REPLACE_WITH_A_FRESH_DECIMAL_UINT256_PER_CYCLE

# Chain id and RPC URL for the network the registry is deployed to.
# Local Hardhat node: 31337 / http://127.0.0.1:8545
# Sepolia: 11155111 / your own RPC URL (never commit a credentialed one)
CHAIN_ID=31337
RPC_URL=http://127.0.0.1:8545

# Deployed GrantCycleRegistry address for CHAIN_ID above.
REGISTRY_ADDRESS=0xREPLACE_WITH_DEPLOYED_REGISTRY_ADDRESS

# Relayer private key. NEVER put a real value here or in any tracked file.
# For local dev, `npm run dev:setup` (scripts/dev-setup.ts) generates a
# fresh one at random and writes it straight into .env.local, then funds it
# from the local Hardhat node's own unlocked account.
RELAYER_PRIVATE_KEY=0xREPLACE_ME_NEVER_COMMIT_A_REAL_KEY

# Optional operational knobs (defaults shown).
CYCLE_SLOTS=60
DRAFT_TTL_MINUTES=30

# Per-route rate limits (intake, applications, volunteer-login are each
# limited independently): at most RATE_LIMIT_MAX_REQUESTS requests per
# RATE_LIMIT_WINDOW_SECONDS-second sliding window, keyed by the caller
# identified via TRUST_PROXY_IP_HEADER below (or one shared bucket per
# route if that's unset).
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=20

# If (and only if) this app runs behind a reverse proxy/load balancer you
# control that sets the client's real IP on a known header, set this to
# that header's name (e.g. X-Forwarded-For) so rate limiting can bucket by
# caller. Leave UNSET for local dev or any deployment without such a proxy:
# a client-supplied IP header is otherwise trivially spoofable, so rate
# limiting instead falls back to one shared bucket per route.
# TRUST_PROXY_IP_HEADER=X-Forwarded-For

# The app's own externally-visible origin (scheme + host + port, no path).
# Used to reject cross-origin volunteer login/logout/review requests
# (CSRF). Must match whatever origin the volunteer dashboard is actually
# served from.
APP_ORIGIN=http://localhost:3010
