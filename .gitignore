# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
contracts/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files - real values are gitignored; .env.example is committed with placeholders only
.env
.env.local
.env.*.local
.env.test.local
contracts/.env
contracts/.env.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# zk artifacts - large binaries fetched by scripts/fetch-zk-artifacts.sh, never committed
public/*.zkey
public/*.wasm
public/vkey.json

# upstream test signing material / generated test QR images - downloaded at test time, never committed
.cache/

# hardhat / contracts build output
contracts/cache/
contracts/artifacts/
contracts/artifacts-zk/
contracts/typechain-types/
contracts/ignition/deployments/

# hardhat keystore (encrypted, but keep local-machine only)
.hardhat/keystore.json
